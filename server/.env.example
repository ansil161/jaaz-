# ---------------------------------------------------------------------------
# JAAZ backend configuration
#
# Copy to server/.env for local development. In production these are set by
# the platform's own secret store — do not ship a .env file to a server.
#
# Generate the two secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------------------

# --- Django core -----------------------------------------------------------
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false; the process refuses to start without it.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database --------------------------------------------------------------
POSTGRES_DB=jaaz_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Seconds to hold a connection open. 0 = a fresh connection per request,
# which is right for runserver and wrong for anything under load.
POSTGRES_CONN_MAX_AGE=0

# --- Access token ----------------------------------------------------------
# Signs and verifies the session JWT. Separate from DJANGO_SECRET_KEY so it
# can be rotated on its own. Rotating it signs everybody out. Required when
# DJANGO_DEBUG=false.
JWT_SECRET=
JWT_ISSUER=jaaz.api
JWT_AUDIENCE=jaaz.console
# Seconds. 8 hours — one working day, then sign in again.
JWT_EXPIRES_IN=28800
# Seconds of tolerance for clock skew between signer and verifier.
JWT_LEEWAY=10

# --- Session cookie --------------------------------------------------------
AUTH_COOKIE_NAME=jaaz_session
# Defaults to the opposite of DJANGO_DEBUG. Setting this to false on a
# production host sends the session token over plain HTTP.
AUTH_COOKIE_SECURE=
# Lax | Strict | None. Lax is correct while the console and the API are
# same-site. 'None' is required for a genuinely cross-site split and then
# also requires AUTH_COOKIE_SECURE=true.
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_PATH=/
# Set to a parent domain (e.g. .example.com) only if the cookie must be
# shared across subdomains.
AUTH_COOKIE_DOMAIN=

# --- Sign-in protection ----------------------------------------------------
# Per-account lockout, stored on the account row.
AUTH_MAX_FAILED_ATTEMPTS=8
AUTH_LOCKOUT_SECONDS=900
# Per-IP throttles. These use Django's cache — see the deployment notes:
# with the default in-memory cache each worker counts separately.
LOGIN_THROTTLE_RATE=10/min
AUTH_READ_THROTTLE_RATE=120/min
# Minimum length enforced when a password is set (not at sign-in).
PASSWORD_MIN_LENGTH=12

# --- CSRF and CORS ---------------------------------------------------------
# Only needed when the browser's origin differs from the API's. Local
# development proxies /api through Vite, so both are empty by default.
# Comma-separated, scheme included: https://console.example.com
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=
CSRF_COOKIE_SECURE=
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=
SESSION_COOKIE_SAMESITE=Lax

# --- Behind a reverse proxy ------------------------------------------------
# Enable each of these ONLY if the proxy sets the header itself and strips
# any copy the client sent. Trusting them otherwise lets a caller claim a
# false scheme or a false source address.
TRUST_X_FORWARDED_PROTO=false
TRUST_X_FORWARDED_FOR=false

# --- HTTPS (ignored while DJANGO_DEBUG=true) -------------------------------
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=false

# --- Knowledge base: storage ------------------------------------------------
# Where uploaded documents are written. Must be OUTSIDE anything the web
# server serves — these files are untrusted input, never content.
KB_STORAGE_ROOT=
# Swap for a django-storages backend to move to object storage, e.g.
# storages.backends.s3.S3Storage (then set the bucket in STORAGES OPTIONS).
KB_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage
# 20 MB.
MAX_DOCUMENT_SIZE=20971520
MIN_DOCUMENT_SIZE=1

# --- Knowledge base: chunking -----------------------------------------------
# Characters, not tokens (roughly 4 characters per token). The right values
# depend on the embedding model's window and on how the documents are written
# — revisit these whenever EMBEDDING_MODEL changes.
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_MIN_CHUNK_SIZE=120
RAG_MAX_CHUNK_SIZE=2400

# --- Knowledge base: embeddings ---------------------------------------------
# hashing | openai
#
# 'hashing' is a deterministic local provider: no key, no network, no cost.
# It runs the whole pipeline out of the box and is what the test suite uses.
# It matches on shared words and spelling, NOT on meaning — it is a
# development convenience and must not be used for production retrieval.
EMBEDDING_PROVIDER=hashing
# For openai: text-embedding-3-small (1536 dims) or -3-large (3072).
EMBEDDING_MODEL=
# Server-side only. Never prefixed VITE_, never returned by an endpoint.
EMBEDDING_API_KEY=
# Any OpenAI-compatible host: Azure OpenAI, vLLM, Ollama, Together.
EMBEDDING_API_BASE=https://api.openai.com/v1
# Leave empty for the model's native width. text-embedding-3-* accept a
# reduced width here. CHANGING THIS INVALIDATES EVERY STORED VECTOR —
# re-process all documents afterwards.
EMBEDDING_DIMENSIONS=
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT=30
EMBEDDING_MAX_RETRIES=3

# --- Knowledge base: vector store -------------------------------------------
# 'postgres' stores vectors in a double precision[] column and searches them
# exactly. No extension required, perfect recall, O(chunks) per query. Fine
# into the low tens of thousands of chunks; past that, install pgvector and
# add a provider.
RAG_VECTOR_STORE=postgres
RAG_SEARCH_TOP_K=5
RAG_SEARCH_MAX_TOP_K=25
RAG_SEARCH_MIN_SCORE=0.0

# --- Knowledge base: processing ---------------------------------------------
# worker | thread | eager | celery
#   worker  the upload returns immediately; `manage.py process_documents`
#           ingests. The production shape. Defaults to this when DEBUG=false.
#   thread  in-process background thread. Convenient with runserver; work is
#           lost on restart. Defaults to this when DEBUG=true.
#   eager   inline, in the request. Tests only.
#   celery  dispatch via Celery task runner (Redis backend).
RAG_TASK_DISPATCH=
RAG_WORKER_POLL_SECONDS=5
# A document stuck mid-ingest for longer than this is assumed to belong to a
# worker that died, and is returned to the queue.
RAG_STALE_PROCESSING_MINUTES=15
RAG_MAX_PROCESSING_ATTEMPTS=5

# --- Celery & Redis --------------------------------------------------------
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# --- Knowledge base: throttling ---------------------------------------------
KB_UPLOAD_THROTTLE_RATE=30/min
KB_WRITE_THROTTLE_RATE=60/min
KB_READ_THROTTLE_RATE=240/min
KB_SEARCH_THROTTLE_RATE=60/min

KNOWLEDGE_BASE_LOG_LEVEL=INFO

# --- Logging ---------------------------------------------------------------
SECURITY_LOG_LEVEL=INFO
