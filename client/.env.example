# Frontend configuration. Copy to client/.env only if you need to override.
#
# Anything prefixed VITE_ is inlined into the bundle at build time and is
# therefore public. Never put a secret here.

# Where the API lives. Leave empty for local development: vite.config.js
# proxies /api to Django, which keeps the browser same-origin with the API
# and is what lets the session cookie stay SameSite=Lax.
#
# Set it only for a deployment that serves the console and the API from
# different origins — and then also set CORS_ALLOWED_ORIGINS and
# CSRF_TRUSTED_ORIGINS on the backend, and AUTH_COOKIE_SAMESITE=None with
# AUTH_COOKIE_SECURE=true.
VITE_API_BASE_URL=
